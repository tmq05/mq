datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  role          Role           @default(USER)
  isLocked      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  refreshTokens RefreshToken[]
  playlists     Playlist[]
  likes         Like[]
  follows       Follow[]
  playHistories      PlayHistory[]
  continueListening  ContinueListening[]
  reports            Report[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([createdAt])
  @@index([isLocked])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Genre {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  imageUrl  String?
  songs     Song[]
  createdAt DateTime @default(now())

  @@map("genres")
}

model Artist {
  id         String    @id @default(uuid())
  name       String
  bio        String?
  imageUrl   String?
  isVerified Boolean   @default(false)
  source     String    @default("local")
  sourceId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  songs     Song[]
  albums    Album[]
  followers Follow[]

  @@index([name])
  @@map("artists")
}

model Album {
  id          String    @id @default(uuid())
  title       String
  coverUrl    String?
  releaseDate DateTime?
  artistId    String?
  artist      Artist?   @relation(fields: [artistId], references: [id], onDelete: SetNull)
  songs       Song[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([title])
  @@map("albums")
}

model Song {
  id           String         @id @default(uuid())
  source       String         // "local" | "audius" | "jamendo" | "youtube" | "deezer" | "itunes" | "spotify"
  sourceId     String
  title        String
  artists      String[]       // List of artist names
  artistId     String?
  artist       Artist?        @relation(fields: [artistId], references: [id], onDelete: SetNull)
  album        String?        // Album name text
  albumId      String?
  albumRef     Album?         @relation(fields: [albumId], references: [id], onDelete: SetNull)
  coverUrl     String?
  durationMs   Int            @default(0)
  playbackType String         @default("audio") // "audio" | "youtube" | "spotify" | "preview"
  streamUrl    String?        // For local uploaded songs
  embedId      String?        // YouTube video ID
  previewUrl   String?        // 30s preview URL
  isFullLength Boolean        @default(true)
  isHidden     Boolean        @default(false)
  lyrics       String?        // LRC format or plaintext
  playCount    Int            @default(0)
  genreId      String?
  genre        Genre?         @relation(fields: [genreId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  playlistSongs PlaylistSong[]
  likes         Like[]
  playHistories PlayHistory[]

  @@unique([source, sourceId])
  @@index([title])
  @@index([source])
  @@index([genreId])
  @@index([createdAt])
  @@index([playCount])
  @@index([isHidden])
  @@map("songs")
}

model Playlist {
  id          String         @id @default(uuid())
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean        @default(true)
  isPinned    Boolean        @default(false)
  isBanned    Boolean        @default(false)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  songs       PlaylistSong[]

  @@index([userId])
  @@index([isPinned])
  @@index([isBanned])
  @@index([createdAt])
  @@map("playlists")
}

model PlaylistSong {
  id         String   @id @default(uuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     String
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  @@unique([playlistId, songId])
  @@index([playlistId, order])
  @@map("playlist_songs")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, songId])
  @@index([userId])
  @@map("likes")
}

model Follow {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, artistId])
  @@index([userId])
  @@map("follows")
}

model PlayHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  songId    String
  song      Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  playedAt  DateTime @default(now())

  @@index([userId, playedAt])
  @@index([playedAt])
  @@index([songId])
  @@map("play_histories")
}

model ContinueListening {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId         String
  progressSeconds Int      @default(0)
  snapshot        Json
  playedAt        DateTime @default(now())

  @@unique([userId, trackId])
  @@index([userId, playedAt])
  @@map("continue_listening")
}

enum ReportStatus {
  PENDING
  PROCESSING
  RESOLVED
  REJECTED
}

enum ReportType {
  COPYRIGHT
  INAPPROPRIATE
  SPAM
  OTHER
}

model Report {
  id            String       @id @default(uuid())
  targetType    String       // "song" | "playlist" | "artist" | "user"
  targetId      String
  targetTitle   String?
  reason        String
  description   String?
  type          ReportType   @default(COPYRIGHT)
  status        ReportStatus @default(PENDING)
  reporterEmail String?
  reporterName  String?
  userId        String?
  user          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  internalNotes String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  userName    String?
  action      String   // e.g. "TOGGLE_USER_LOCK", "CHANGE_USER_ROLE", "DELETE_USER", "CREATE_SONG", "UPDATE_SONG", "DELETE_SONG", "CREATE_ARTIST", "UPDATE_ARTIST", "DELETE_ARTIST", "TOGGLE_PLAYLIST_PIN", "TOGGLE_PLAYLIST_BAN", "DELETE_PLAYLIST", "TAKEDOWN_REPORT", "UPDATE_REPORT", "TOGGLE_PROVIDER", "UPDATE_SETTINGS"
  targetType  String?  // "USER" | "SONG" | "ARTIST" | "PLAYLIST" | "REPORT" | "PROVIDER" | "SYSTEM"
  targetId    String?
  targetTitle String?
  details     String?  // JSON string or notes
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model SystemSetting {
  key         String   @id
  value       String   // text or JSON
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ============================================================================
// HỆ THỐNG QUẢN LÝ CHATBOT ("Trợ lý mq")
// ============================================================================

model ChatbotSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("chatbot_settings")
}

model PromptVersion {
  id               String   @id @default(uuid())
  version          Int      @default(1)
  content          String
  status           String   @default("draft") // "draft" | "active" | "archived"
  note             String?
  abTrafficPercent Int      @default(0)
  createdBy        String?
  createdAt        DateTime @default(now())

  conversations    ChatConversation[]

  @@index([status])
  @@index([createdAt])
  @@map("prompt_versions")
}

model ChatConversation {
  id              String          @id @default(uuid())
  userId          String?
  userName        String?
  ipHash          String?
  startedAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  promptVersionId String?
  promptVersion   PromptVersion?  @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)
  model           String          @default("gemini-2.0-flash")
  totalTokenIn    Int             @default(0)
  totalTokenOut   Int             @default(0)
  totalTokens     Int             @default(0)
  cost            Float           @default(0)
  latencyMs       Int             @default(0)
  hasError        Boolean         @default(false)
  hasToolCall     Boolean         @default(false)
  hasBadFeedback  Boolean         @default(false)
  flagged         Boolean         @default(false)
  flagReason      String?
  flagStatus      String          @default("open") // "open" | "ignored" | "blocked" | "noted"
  flagNote        String?

  messages        ChatMessageLog[]
  toolCalls       ChatToolCallLog[]

  @@index([userId])
  @@index([startedAt])
  @@index([hasError])
  @@index([hasToolCall])
  @@index([hasBadFeedback])
  @@index([flagged])
  @@map("conversations")
}

model ChatMessageLog {
  id               String            @id @default(uuid())
  conversationId   String
  conversation     ChatConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role             String            // "user" | "assistant" | "system"
  content          String
  tokenIn          Int               @default(0)
  tokenOut         Int               @default(0)
  latencyMs        Int               @default(0)
  feedback         String?           // "up" | "down"
  feedbackReason   String?
  feedbackLabels   String[]          @default([])
  feedbackResolved Boolean           @default(false)
  isTestCase       Boolean           @default(false)
  createdAt        DateTime          @default(now())

  toolCalls        ChatToolCallLog[]

  @@index([conversationId, createdAt])
  @@index([feedback])
  @@index([feedbackResolved])
  @@map("messages")
}

model ChatToolCallLog {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  messageId      String?
  message        ChatMessageLog?  @relation(fields: [messageId], references: [id], onDelete: SetNull)
  stepIndex      Int              @default(1)
  toolName       String
  args           Json
  resultSummary  Json
  status         String           @default("success") // "success" | "error" | "needs_confirmation"
  durationMs     Int              @default(0)
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([toolName])
  @@index([status])
  @@index([createdAt])
  @@map("tool_calls")
}

model ChatbotUsageDaily {
  id             String   @id @default(uuid())
  date           String   // YYYY-MM-DD
  model          String
  tokenIn        Int      @default(0)
  tokenOut       Int      @default(0)
  cost           Float    @default(0)
  requests       Int      @default(0)
  errors         Int      @default(0)
  totalLatencyMs Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([date, model])
  @@index([date])
  @@map("usage_daily")
}

model BlockedEntity {
  id        String    @id @default(uuid())
  type      String    // "user" | "ip"
  value     String
  reason    String
  createdBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  @@unique([type, value])
  @@index([type, value])
  @@index([expiresAt])
  @@map("blocked_entities")
}

model FaqEntry {
  id        String   @id @default(uuid())
  title     String
  content   String
  source    String?
  category  String   @default("general")
  isEnabled Boolean  @default(true)
  updatedBy String?
  history   Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isEnabled])
  @@index([category])
  @@map("faq_entries")
}



